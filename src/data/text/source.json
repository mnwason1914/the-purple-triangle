  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "neutral"
 },
 {
  "id": "t1810osr",
  "text": "토요일 이 시간에 빵을 파는 집이 있나 보군요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 645,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "stern"
 },
 {
