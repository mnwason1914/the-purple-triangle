  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 701,
  "scene": "street",
  "kind": "label"
 },
 {
  "id": "trvszis",
  "text": "통 뒤에 숨기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 701,
  "scene": "street",
  "kind": "label"
 },
 {
  "id": "txn4rxh",
