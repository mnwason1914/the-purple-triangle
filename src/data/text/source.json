[
 {
  "id": "t14bpyw8",
  "text": "1936년 12월 12일, 토요일<small>베스트팔렌 · 린덴펠트</small>",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 175,
  "scene": "morning",
  "kind": "card"
 },
 {
  "id": "ti7b923",
  "text": "파울의 겨울 외투. 소매만 마저 꿰매면 된다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 180,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1709ldw",
  "text": "로테는 정오에 돌아온다. 토요일이니까.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 181,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t7kipec",
  "text": "집 안을 둘러보자 · 재봉틀에서 일을 마치기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 184,
  "scene": "morning",
  "kind": "objective"
 },
 {
  "id": "tmo1abd",
  "text": "조사",
  "uses": 7,
  "file": "src/data/chapter1.ts",
  "line": 189,
  "scene": "morning",
  "kind": "label"
 },
 {
  "id": "t122g5v1",
  "text": "…치직… 민족 공동체 안에서 모든 독일인은… 치직…",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 191,
  "scene": "morning",
  "kind": "voice",
  "speaker": "라디오"
 },
 {
  "id": "taspr1k",
  "text": "끈다. 토요일 아침까지 듣고 싶지는 않다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 192,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1o8j46h",
  "text": "12일. 동그라미 하나. 파울이 그려 놓았다. 무슨 뜻인지는 둘만 안다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 196,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1gmlwwn",
  "text": "1924년, 결혼식 날. 파울은 저 모자를 아직도 쓴다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 200,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1ynvgpm",
  "text": "창밖",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 203,
  "scene": "morning",
  "kind": "label"
 },
 {
  "id": "t1icygom",
  "text": "맞은편 창가에 크뤼거 부인. 오늘도 거리를 내려다보고 있다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 204,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1km0vkq",
  "text": "그녀의 남편이 이 구역 반장이 된 뒤로, 인사를 받아 주지 않는다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 205,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "tbe4dbq",
  "text": "러그 밑, 헐거운 마룻장 하나. 지금은 비어 있다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 209,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t19rgge5",
  "text": "타일 난로에 아직 온기가 남아 있다. 석탄은 다음 주까지 버텨야 한다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 213,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t61mnj2",
  "text": "로테의 책가방 자리. 오늘은 가방을 메고 갔다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 217,
  "scene": "morning",
  "kind": "thought"
 },
 {
  "id": "t1fqs5pi",
  "text": "재봉",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 220,
  "scene": "morning",
  "kind": "label"
 },
 {
  "id": "tm3u62n",
  "text": "벌써 왔니? 아직 열한 시도 안 됐는데.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 238,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "smile"
 },
 {
  "id": "tn00j3b",
  "text": "쉬츠 선생님이 집에 가래.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 240,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "sad"
 },
 {
  "id": "tsvyszc",
  "text": "무슨 일이 있었어?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 241,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "worried"
 },
 {
  "id": "t13b7ipo",
  "text": "아침에 다 같이 일어나서 팔을 들고 \"하일 히틀러\" 했어. 나만 안 했어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 242,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "t5qf21n",
  "text": "선생님이 반 애들 앞에서 나보고 \"배신자네 집 애\"라고 했어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 243,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "sad"
 },
 {
  "id": "tpnep3z",
  "text": "그리고 이거 엄마 아빠한테 주래.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 244,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "worried"
 },
 {
  "id": "t1f4s7bs",
  "text": "교장 직인이 찍힌 편지. \"학부모는 월요일까지 학교로 출석할 것.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 246,
  "scene": "lotteComesHome",
  "kind": "thought"
 },
 {
  "id": "tpmxk4",
  "text": "로테를 꼭 안아 준다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 248,
  "scene": "lotteComesHome",
  "kind": "choice"
 },
 {
  "id": "t1rye5zm",
  "text": "\"잘했어. 넌 옳은 일을 한 거야.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 248,
  "scene": "lotteComesHome",
  "kind": "choice"
 },
 {
  "id": "tyj5c7k",
  "text": "\"…다음엔 그냥 조용히 있으렴. 팔만 살짝 들어도 돼.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 248,
  "scene": "lotteComesHome",
  "kind": "choice"
 },
 {
  "id": "tn0kna9",
  "text": "무서웠지.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 251,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "sad"
 },
 {
  "id": "tip6yoq",
  "text": "응… 근데 엄마, 나 울지는 않았어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 252,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "sad"
 },
 {
  "id": "t2ocjn2",
  "text": "알아. 넌 엄마보다 용감해.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 253,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "smile"
 },
 {
  "id": "t17qm17o",
  "text": "잘했어. 넌 옳은 일을 한 거야.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 256,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "resolute"
 },
 {
  "id": "t1bqgbnc",
  "text": "그럼 월요일에도 안 해도 돼?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 257,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "worried"
 },
 {
  "id": "t1if9qpr",
  "text": "…월요일엔 엄마가 같이 학교에 갈게.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 258,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "worried"
 },
 {
  "id": "t5ua8aa",
  "text": "다음엔 그냥 조용히 있으렴. 팔만 살짝 들어도 아무도 몰라.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 261,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "worried"
 },
 {
  "id": "t1c2gf39",
  "text": "…엄마는 안 하잖아.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 262,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "sad"
 },
 {
  "id": "tifgu7a",
  "text": "대답할 말이 없었다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 263,
  "scene": "lotteComesHome",
  "kind": "thought"
 },
 {
  "id": "t1qkfa9f",
  "text": "토요일이라 반나절이야. 신호소엔 마이어가 남았어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 275,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "neutral"
 },
 {
  "id": "tqv5juo",
  "text": "오는 길에 요한한테 들렀어. 이건 새로 온 「파수대」.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 277,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "worried"
 },
 {
  "id": "t1pdjcuw",
  "text": "그리고 이건 요한의 편지야. 오늘 밤 일. 읽고 나면 없애.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 279,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "stern"
 },
 {
  "id": "talcj1v",
  "text": "당신이 가면 안 돼? 오늘 밤.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 281,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "worried"
 },
 {
  "id": "t1i63t8s",
  "text": "신호소에서 누가 내 도시락까지 뒤졌어. 지금 날 보고 있는 눈이 너무 많아.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 282,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "worried"
 },
 {
  "id": "t1jkoiiq",
  "text": "다섯 시부터 일곱 시까지. 전국에서 같은 시간에. …당신이 가 줘.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 283,
  "scene": "lotteComesHome",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "resolute"
 },
 {
  "id": "t1pqwzqv",
  "text": "하르트만! 문 여시오. 경찰이오.",
  "uses": 2,
  "file": "src/data/chapter1.ts",
  "line": 294,
  "scene": "lotteComesHome",
  "kind": "voice",
  "speaker": "문밖"
 },
 {
  "id": "tmz049r",
  "text": "새 호는 탁자 위에. 지난 호들은 선반과 침대 머리맡에. 그리고 손에는 요한의 편지.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 352,
  "scene": "hideSequence",
  "kind": "thought"
 },
 {
  "id": "tz3xypu",
  "text": "노이만 씨 집에서는 옷장과 바구니부터 뒤졌다고 했다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 353,
  "scene": "hideSequence",
  "kind": "thought"
 },
 {
  "id": "twkhfck",
  "text": "「파수대」 세 부와 편지를 숨기자",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 355,
  "scene": "hideSequence",
  "kind": "objective"
 },
 {
  "id": "tuadpst",
  "text": "문 두드리는 소리가 커진다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 356,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "t1rrayzo",
  "text": "집기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 359,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "t14mk5q9",
  "text": "커피포트",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 367,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "t5nv88l",
  "text": "편지를 커피포트 안에 접어 넣었다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 368,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "t1crx8lv",
  "text": "태우기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 370,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "tjd0y81",
  "text": "편지는 재가 되었다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 371,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "tfjrgza",
  "text": "감자 상자",
  "uses": 2,
  "file": "src/data/chapter1.ts",
  "line": 373,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "ts9mdn7",
  "text": "감자 밑에 묻었다. 하나가 겨우 들어간다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 375,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "t4sl3jj",
  "text": "바구니",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 377,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "t1lfxf1c",
  "text": "천 조각 밑에 밀어 넣었다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 378,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "txjvkix",
  "text": "옷장",
  "uses": 2,
  "file": "src/data/chapter1.ts",
  "line": 380,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "tvxy164",
  "text": "침대보 사이에 끼워 넣었다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 381,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "t1m6uvgz",
  "text": "마룻장",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 383,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "tobietg",
  "text": "마룻장 밑은 두 부가 한계다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 386,
  "scene": "hideSequence",
  "kind": "toast"
 },
 {
  "id": "tjkx98p",
  "text": "로테에게",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 388,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "t1x596zk",
  "text": "…내 가방에. 공책 사이에.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 390,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "resolute"
 },
 {
  "id": "trz0wgt",
  "text": "엄마… 나 무서워.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 395,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "tijj0zf",
  "text": "로테는 손을 뒤로 숨겼다. 시간이 없다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 397,
  "scene": "hideSequence",
  "kind": "thought"
 },
 {
  "id": "t3b75u1",
  "text": "문 열기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 401,
  "scene": "hideSequence",
  "kind": "label"
 },
 {
  "id": "t1oc8v54",
  "text": "문밖에서 기다리는 시간 · {0}",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 415,
  "scene": "hideSequence",
  "kind": "counter"
 },
 {
  "id": "td3k7o7",
  "text": "자물쇠공! 열어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 432,
  "scene": "hideSequence",
  "kind": "voice",
  "speaker": "문밖"
 },
 {
  "id": "t1dhac2t",
  "text": "문 하나 여는 데 꽤 오래 걸리는군, 하르트만 부인.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 446,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "tybr02j",
  "text": "하르트만 부인. 국가경찰 포크트요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 446,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "twobq6x",
  "text": "하일 히틀러.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 447,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "tas38or",
  "text": "아무 말도 하지 않는다",
  "uses": 2,
  "file": "src/data/chapter1.ts",
  "line": 448,
  "scene": "hideSequence",
  "kind": "choice"
 },
 {
  "id": "tiyzcvy",
  "text": "\"안녕하세요.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 448,
  "scene": "hideSequence",
  "kind": "choice"
 },
 {
  "id": "t1i2tvgq",
  "text": "\"저는 그 인사를 할 수 없습니다.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 448,
  "scene": "hideSequence",
  "kind": "choice"
 },
 {
  "id": "t1utp6xu",
  "text": "…좋소. 침묵도 대답이지.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 449,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "trddxc8",
  "text": "안녕하세요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 450,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "neutral"
 },
 {
  "id": "txqxpv7",
  "text": "\"안녕하세요\". 요즘 그렇게 말하는 사람은 둘뿐이오. 늙은 사제들과, 당신들.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 450,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "t15lvfgs",
  "text": "저는 그 인사를 할 수 없습니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 453,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "resolute"
 },
 {
  "id": "ty8mro4",
  "text": "기록해 두시오, 브란트.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 454,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "t702ww4",
  "text": "이 집에 금지된 인쇄물이 있다는 신고가 들어왔소. 뒤져.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 457,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "t14k9sl7",
  "text": "손에 든 그건 뭐요. 이리 주시오.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 469,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "t12h8q0q",
  "text": "숨길 생각도 안 했군요. 여기저기 그대로 있습니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 476,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "brandt",
  "expr": "neutral"
 },
 {
  "id": "tzcny3g",
  "text": "여기 하나 그대로 있습니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 476,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "brandt",
  "expr": "neutral"
 },
 {
  "id": "tekhd1w",
  "text": "탁자",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 479,
  "scene": "hideSequence",
  "kind": "text"
 },
 {
  "id": "t19currq",
  "text": "재봉 바구니",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 480,
  "scene": "hideSequence",
  "kind": "text"
 },
 {
  "id": "t8rnzyd",
  "text": "난로",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 481,
  "scene": "hideSequence",
  "kind": "text"
 },
 {
  "id": "t1mibnnt",
  "text": "불 속에 종이 탄 자국이 있습니다. 읽을 수는 없습니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 482,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "brandt",
  "expr": "neutral"
 },
 {
  "id": "t1h5zpf2",
  "text": "러그 밑",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 485,
  "scene": "hideSequence",
  "kind": "text"
 },
 {
  "id": "t15ohmng",
  "text": "그 가방, 이리 줘 보렴.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 489,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "t1yrg0oy",
  "text": "…숙제밖에 없어요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 492,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "ti2yton",
  "text": "포크트 씨. 애 가방까지 뒤질 것까진 없잖소.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 493,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "brandt",
  "expr": "neutral"
 },
 {
  "id": "tcrdg4n",
  "text": "…이 동네는 마음이 약하군.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 494,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "to6d4fj",
  "text": "…여기요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 497,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "worried"
 },
 {
  "id": "tk06n92",
  "text": "숙제뿐이군.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 499,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "t1eq5n5l",
  "text": "「파수대」. 스위스에서 들어온 거지. 이걸 누가 가져다주었소?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 513,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "tl9ypnw",
  "text": "\"오늘 다섯 시, 빵집 뒷문. 한 집에 한 장.\" …이 편지, 누가 썼소?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 515,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "tu1nxuw",
  "text": "아무것도 없군. 오늘은.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 517,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "ttavern",
  "text": "하지만 당신들이 모이는 걸 우린 알고 있소. 누가 당신들에게 책을 넘겨주지?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 518,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "t1qfanmi",
  "text": "\"모릅니다.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 521,
  "scene": "hideSequence",
  "kind": "choice"
 },
 {
  "id": "tiridi8",
  "text": "\"…빵집의 요한 베커입니다.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 521,
  "scene": "hideSequence",
  "kind": "choice"
 },
 {
  "id": "trnot10",
  "text": "…빵집의, 요한 베커입니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 524,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "afraid"
 },
 {
  "id": "t16y2dhf",
  "text": "엘리제…",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 526,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "sad"
 },
 {
  "id": "t1a8e3zu",
  "text": "거 봐요. 어렵지 않잖소.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 527,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "smile"
 },
 {
  "id": "t1cu5dx8",
  "text": "모릅니다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 529,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "resolute"
 },
 {
  "id": "t17c045u",
  "text": "다들 그렇게 말하지. 처음에는.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 530,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "t1wbxjif",
  "text": "당신 딸이 보고 있소, 부인. 그 애한테 무엇을 가르치는지 잘 생각해 보시오.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 533,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "tta9mij",
  "text": "하르트만 씨는 우리와 함께 갑니다. 몇 가지 물어볼 게 있어서.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 538,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "neutral"
 },
 {
  "id": "t1vk6dgn",
  "text": "…로테, 엄마 말 잘 들어.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 539,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "resolute"
 },
 {
  "id": "tj1riew",
  "text": "아빠!",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 540,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "tn7qy8z",
  "text": "다음에 올 때는 오늘처럼 친절하지 않을 거요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 547,
  "scene": "hideSequence",
  "kind": "dialogue",
  "speaker": "vogt",
  "expr": "stern"
 },
 {
  "id": "tvgdz30",
  "text": "편지에는 빵집이 적혀 있었다. 요한에게 알려야 한다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 556,
  "scene": "hideSequence",
  "kind": "thought"
 },
 {
  "id": "t1mad2ac",
  "text": "커피포트. 그들은 뚜껑조차 열어 보지 않았다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 557,
  "scene": "hideSequence",
  "kind": "thought"
 },
 {
  "id": "t1a97m1j",
  "text": "오후 4시 40분",
  "uses": 2,
  "file": "src/data/chapter1.ts",
  "line": 559,
  "scene": "hideSequence",
  "kind": "card"
 },
 {
  "id": "thm1fn2",
  "text": "아직 늦지 않았어. 오늘은 그냥 집에 있어도 돼.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 580,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "worried"
 },
 {
  "id": "t1ytkg2h",
  "text": "…요한은 오늘 밤 그 사람들이 온다는 걸 몰라.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 582,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "sad"
 },
 {
  "id": "t1bt33gi",
  "text": "아빠는 언제 와?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 585,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "sad"
 },
 {
  "id": "t1ua0yxo",
  "text": "…곧.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 586,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "worried"
 },
 {
  "id": "tfzyjt6",
  "text": "파울을 데려간 건 세 시간 전이다. 아무 소식도 없다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 587,
  "scene": "dusk",
  "kind": "thought"
 },
 {
  "id": "t1hh8f1x",
  "text": "코트를 여민다. \"다녀올게.\"",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 589,
  "scene": "dusk",
  "kind": "choice"
 },
 {
  "id": "t1637a0s",
  "text": "오늘 밤은 집에 남는다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 589,
  "scene": "dusk",
  "kind": "choice"
 },
 {
  "id": "tqg34vp",
  "text": "…오늘은 여기 있을게.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 592,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "sad"
 },
 {
  "id": "t15ehkcx",
  "text": "그래. 그것도 용기야.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 593,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "paul",
  "expr": "sad"
 },
 {
  "id": "t1dh0rkz",
  "text": "엄마, 창밖에 누가 있어. 우체통 앞에.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 594,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "worried"
 },
 {
  "id": "t1dsmpwy",
  "text": "눈 속에서, 누군가가 우체통에 무언가를 밀어 넣고 서둘러 사라졌다.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 595,
  "scene": "dusk",
  "kind": "thought"
 },
 {
  "id": "turt3qs",
  "text": "같은 시간, 이 나라 곳곳에서.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 596,
  "scene": "dusk",
  "kind": "thought"
 },
 {
  "id": "t1jv0872",
  "text": "아빠랑 기다릴게.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 601,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "resolute"
 },
 {
  "id": "t1jg2zgl",
  "text": "나 혼자 있을 수 있어. 문 잠글게.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 601,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "resolute"
 },
 {
  "id": "t1ijcm2z",
  "text": "…빨리 와야 돼.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 602,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "t1x7lyul",
  "text": "가지 마… 엄마까지 가면 안 돼.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 602,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "lotte",
  "expr": "afraid"
 },
 {
  "id": "t17xv8ii",
  "text": "크뤼거 부인 집 문을 두드리렴. 무슨 일이 있으면.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 603,
  "scene": "dusk",
  "kind": "dialogue",
  "speaker": "elise",
  "expr": "sad"
 },
 {
  "id": "tob378b",
  "text": "현관문으로 나가자",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 606,
  "scene": "dusk",
  "kind": "objective"
 },
 {
  "id": "t18ybnkf",
  "text": "나가기",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 608,
  "scene": "dusk",
  "kind": "label"
 },
 {
  "id": "t9tjp45",
  "text": "계단을 내려가자",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 625,
  "scene": "stairwell",
  "kind": "objective"
 },
 {
  "id": "tbotlw1",
  "text": "대화",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 628,
  "scene": "stairwell",
  "kind": "label"
 },
 {
  "id": "t169yyux",
  "text": "…하르트만 부인. 이 시간에 어딜 가요. 이 눈에.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 631,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "stern"
 },
 {
  "id": "tg0juo1",
  "text": "낮에 파울 씨를 데려가는 걸 봤어요.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 632,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "worried"
 },
 {
  "id": "t59jex7",
  "text": "낮에… 다 들렸어요. 이 건물 벽은 얇으니까.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 633,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "worried"
 },
 {
  "id": "t1ckcfiz",
  "text": "석탄통을 대신 들어 준다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 634,
  "scene": "stairwell",
  "kind": "choice"
 },
 {
  "id": "tcsglho",
  "text": "\"빵 사러요.\" 하고 지나간다",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 634,
  "scene": "stairwell",
  "kind": "choice"
 },
 {
  "id": "t1hzhzf5",
  "text": "…고마워요. 남편은 이런 건 안 해 줘요. 회의만 다니지.",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 641,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "sad"
 },
 {
  "id": "tf0jbgx",
  "text": "오늘 밤엔 커튼을 일찍 칠 거예요. 눈이 아파서. …알겠어요?",
  "uses": 1,
  "file": "src/data/chapter1.ts",
  "line": 642,
  "scene": "stairwell",
  "kind": "dialogue",
  "speaker": "kruger",
  "expr": "worried"
 },
 {
  "id": "tlhr0ni",
